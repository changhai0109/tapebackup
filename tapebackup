DIR_INDEX_SCHEMA = """
CREATE TABLE IF NOT EXISTS dir_index(
  host TEXT NOT NULL, parent TEXT NOT NULL, name TEXT NOT NULL,
  is_dir INTEGER NOT NULL, size INTEGER, n_files INTEGER, mtime INTEGER,
  started TEXT, tape TEXT, file_no INTEGER,
  PRIMARY KEY(host,parent,name)) WITHOUT ROWID;
CREATE TABLE IF NOT EXISTS dir_built(sid TEXT PRIMARY KEY);
"""

_UPSERT_DIR = (
    "INSERT INTO dir_index(host,parent,name,is_dir,size,n_files,mtime,started,tape,file_no)"
    " VALUES(?,?,?,?,?,?,?,?,?,?) ON CONFLICT(host,parent,name) DO UPDATE SET"
    " is_dir=excluded.is_dir, size=excluded.size, n_files=excluded.n_files,"
    " mtime=excluded.mtime, started=excluded.started, tape=excluded.tape,"
    " file_no=excluded.file_no WHERE excluded.started >= dir_index.started")

_ADD_DIR = (
    "INSERT INTO dir_index(host,parent,name,is_dir,size,n_files,mtime,started,tape,file_no)"
    " VALUES(?,?,?,1,?,?,NULL,?,?,?) ON CONFLICT(host,parent,name) DO UPDATE SET"
    " size=coalesce(dir_index.size,0)+excluded.size,"
    " n_files=coalesce(dir_index.n_files,0)+excluded.n_files,"
    " started=excluded.started, tape=excluded.tape, file_no=excluded.file_no")


def dir_index_open(ctx):
    """Aux DB holding a directory tree (parent/name). Kept in its own file so
    building/refreshing it never competes with index writes of a live backup."""
    p = os.path.join(ctx.dir, "dir_index.db")
    c = sqlite3.connect(p, timeout=30)
    c.executescript(DIR_INDEX_SCHEMA)
    return c


def ensure_dir_index(ctx, cmain, cd):
    """Incrementally fold sessions that are not in dir_index yet.

    Sessions are chunks, so several sessions can cover one tree.  File rows
    keep the newest version; directory rows keep running totals, adjusted by
    the delta when a newer session changes (or re-adds) a file."""
    built = {r[0] for r in cd.execute("SELECT sid FROM dir_built")}
    todo = [r for r in cmain.execute(
                "SELECT sid,host_name,started FROM sessions ORDER BY started, sid")
            if r[0] not in built]
    cd.execute("CREATE TEMP TABLE IF NOT EXISTS _nf("
               "parent TEXT, name TEXT, size INTEGER, mtime INTEGER)")
    for sid, host, started in todo:
        st = cmain.execute("SELECT tape,file_no FROM session_tapes"
                           " WHERE sid=? AND seq=1", (sid,)).fetchone()
        tape, fno = (st[0], st[1]) if st else (None, None)
        cd.execute("DELETE FROM _nf")
        batch = []
        for path, size, mtime in cmain.execute(
                "SELECT path,size,mtime FROM file_index WHERE sid=?", (sid,)):
            if "/" in path:
                parent, name = path.rsplit("/", 1)
            else:
                parent, name = "", path
            batch.append((parent, name, size, mtime))
            if len(batch) >= 50000:
                cd.executemany("INSERT INTO _nf VALUES(?,?,?,?)", batch)
                batch = []
        if batch:
            cd.executemany("INSERT INTO _nf VALUES(?,?,?,?)", batch)
        rows = cd.execute(
            "SELECT n.parent,n.name,n.size,n.mtime,d.size,d.started"
            " FROM _nf n LEFT JOIN dir_index d"
            "   ON d.host=? AND d.parent=n.parent AND d.name=n.name",
            (host,)).fetchall()
        files, deltas = [], {}
        for parent, name, size, mtime, oldsize, oldstarted in rows:
            if oldstarted and started and started < oldstarted:
                continue
            sz = size or 0
            if oldsize is None:
                dn, delta = 1, sz
            else:
                dn, delta = 0, sz - (oldsize or 0)
            files.append((host, parent, name, 0, size, None, mtime,
                          started, tape, fno))
            d = parent
            while d:
                p2, _, n2 = d.rpartition("/")
                e = deltas.get((p2, n2))
                if e is None:
                    deltas[(p2, n2)] = [dn, delta]
                else:
                    e[0] += dn
                    e[1] += delta
                d = p2
        cd.executemany(_UPSERT_DIR, files)
        cd.executemany(_ADD_DIR,
                       [(host, p, n, delta_bytes, dn, started, tape, fno)
                        for (p, n), (dn, delta_bytes) in deltas.items()])
        cd.execute("INSERT OR REPLACE INTO dir_built(sid) VALUES(?)", (sid,))
        cd.commit()
    return len(todo)


def _ls_children(cd, host, parent):
    return cd.execute(
        "SELECT name,is_dir,size,n_files,mtime,started,tape,file_no"
        " FROM dir_index WHERE host=? AND parent=? ORDER BY name",
        (host, parent)).fetchall()


def _ls_walk(cd, host, parent, base):
    for name, isdir, size, nf, mtime, started, tape, fno in _ls_children(cd, host, parent):
        p = (base + "/" + name) if base else name
        if isdir:
            _ls_walk(cd, host, p, p)
        else:
            mts = time.strftime("%Y-%m-%d", time.localtime(mtime)) if mtime else "-"
            print("%-10s %-19s %-10s %10s %-24s %s" % (
                host, started, human(size), mts, tape or "-", p))


def cmd_ls(ctx, args):
    """Browse the index: ls [-R] [HOST:]PATH  (latest version wins)"""
    recursive = any(a in ("-R", "--recursive") for a in args)
    args = [a for a in args if a not in ("-R", "--recursive")]
    target = args[0] if args else None
    host = None
    path = ""
    if target:
        if ":" in target:
            host, path = target.split(":", 1)
        else:
            path = target
        path = path.lstrip("/").rstrip("/")
    cmain = db_open(ctx)
    cd = dir_index_open(ctx)
    ensure_dir_index(ctx, cmain, cd)
    hosts = [host] if host else [r[0] for r in cmain.execute(
        "SELECT DISTINCT host_name FROM sessions WHERE host_name IS NOT NULL"
        " ORDER BY host_name")]
    cmain.close()
    if not target:
        for h in hosts:
            printed = False
            for name, isdir, size, nf, mtime, started, tape, fno in _ls_children(cd, h, ""):
                if not printed:
                    print("%s:" % h)
                    printed = True
                if isdir:
                    print("  d  %-40s %6d files  %10s" % (
                        name + "/", nf or 0, human(size or 0)))
                else:
                    print("  f  %-40s %10s" % (name, human(size or 0)))
        cd.close()
        return
    if recursive:
        print("%-10s %-19s %-10s %10s %-24s %s" % (
            "host", "backup time", "size", "mtime", "tape", "path"))
        for h in hosts:
            _ls_walk(cd, h, path, path)
        cd.close()
        return
    found = False
    for h in hosts:
        rows = _ls_children(cd, h, path)
        if not rows:
            continue
        found = True
        print("%s:" % h)
        for name, isdir, size, nf, mtime, started, tape, fno in rows:
            if isdir:
                print("  d  %-44s %10s  (%d files)" % (
                    name + "/", human(size or 0), nf or 0))
            else:
                print("  f  %-44s %10s" % (name, human(size or 0)))
    if not found:
        parent, _, name = path.rpartition("/")
        for h in hosts:
            row = cd.execute(
                "SELECT size,tape FROM dir_index WHERE host=? AND parent=? AND name=?",
                (h, parent, name)).fetchone()
            if row:
                found = True
                print("%-10s %-10s %-24s %s" % (h, human(row[0]), row[1] or "-", path))
        if not found:
            print("(nothing under %s)" % (target,))
    cd.close()


def cmd_remove(ctx, args):
    """remove [--yes] [--prune-dirs] PATH...

    Delete local files only when the index proves they are already on tape
    unchanged: the path must be indexed, its session committed, its size and
    mtime identical to the indexed copy, and the tape that holds it must still
    be present in the index (i.e. not erased).  Dry-run unless --yes is given.
    """
    yes = "--yes" in args or "-y" in args
    prune = "--prune-dirs" in args
    args = [a for a in args if a not in ("--yes", "-y", "--prune-dirs")]
    if not args:
        die("usage: remove [--yes] [--prune-dirs] PATH...")
    host = ctx.host_name
    c = db_open(ctx)
    q = ("SELECT f.size,f.mtime,s.status,st.tape"
         " FROM file_index f JOIN sessions s ON s.sid=f.sid"
         " LEFT JOIN session_tapes st ON st.sid=f.sid AND st.seq=1"
         " WHERE f.path=? AND s.host_name=? ORDER BY s.started DESC LIMIT 1")
    ok = skip = 0
    okbytes = 0
    dirs = set()
    for target in args:
        ap = os.path.abspath(target)
        if os.path.islink(ap) or not os.path.exists(ap):
            print("SKIP (missing or symlink): %s" % target)
            skip += 1
            continue
        if os.path.isdir(ap):
            files = []
            for root, _dns, fns in os.walk(ap):
                dirs.add(root)
                for fn in fns:
                    fp = os.path.join(root, fn)
                    if os.path.islink(fp) or not os.path.isfile(fp):
                        continue
                    files.append(fp)
        else:
            files = [ap]
            dirs.add(os.path.dirname(ap))
        for fp in files:
            rel = fp.lstrip("/")
            try:
                st = os.stat(fp)
            except OSError as e:
                print("SKIP (stat failed: %s): %s" % (e, fp))
                skip += 1
                continue
            row = c.execute(q, (rel, host)).fetchone()
            if not row:
                print("SKIP (not in index): %s" % fp)
                skip += 1
                continue
            isize, imtime, status, tape = row
            if status != 1:
                print("SKIP (session not committed): %s" % fp)
                skip += 1
                continue
            if isize != st.st_size:
                print("SKIP (size changed: index %s, disk %s): %s"
                      % (human(isize or 0), human(st.st_size), fp))
                skip += 1
                continue
            if imtime is None or int(imtime) != int(st.st_mtime):
                print("SKIP (mtime changed: index %s, disk %s): %s"
                      % (imtime, int(st.st_mtime), fp))
                skip += 1
                continue
            if not tape or not c.execute(
                    "SELECT 1 FROM tapes WHERE cid=?", (tape,)).fetchone():
                print("SKIP (tape %s not in index): %s" % (tape or "-", fp))
                skip += 1
                continue
            if yes:
                try:
                    os.unlink(fp)
                except OSError as e:
                    print("ERROR (%s): %s" % (e, fp))
                    skip += 1
                    continue
                print("DELETED %s  [%s]" % (fp, tape))
            else:
                print("WOULD DELETE %s  [%s]" % (fp, tape))
            ok += 1
            okbytes += st.st_size
    if prune and yes:
        for d in sorted(dirs, key=len, reverse=True):
            try:
                if os.path.isdir(d) and not os.listdir(d):
                    os.rmdir(d)
            except OSError:
                pass
    c.close()
    print("---")
    print("%s %d file(s), %s%s" % (
        "removed" if yes else "would remove", ok, human(okbytes),
        "" if yes else "  (dry run; add --yes to delete)"))
    if skip:
        print("skipped %d file(s)" % skip)


