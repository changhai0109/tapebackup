def _ready_cmd(argv):
    dev = argv[1] if len(argv) > 1 else "/dev/nst0"
    try:
        ok, msg = drive_wait_ready(dev)
    except Exception as e:
        print(json.dumps({"ready": False, "error": str(e)}))
        sys.exit(2)
    print(json.dumps({"ready": ok, "msg": msg}))
    sys.exit(0 if ok else 2)


def _erase_cmd(argv):
    dev = argv[1] if len(argv) > 1 else "/dev/nst0"
    long = len(argv) > 2 and argv[2] == "long"
    try:
        ok, sense = sg_erase_dev(dev, long)
    except Exception as e:
        print(json.dumps({"erased": False, "error": str(e)}))
        sys.exit(2)
    print(json.dumps({"erased": ok, "sense": sense.hex()}))
    sys.exit(0 if ok else 2)


def _load_cmd(argv):
    dev = argv[1] if len(argv) > 1 else "/dev/nst0"
    try:
        sg = sg_name_for_st(dev)
        fd = os.open(sg, os.O_RDWR)
        try:
            sg_issue(fd, bytes([0x1B, 0, 0, 0, 1, 0]), 0, SG_DXFER_NONE)
        finally:
            os.close(fd)
        print(json.dumps({"loaded": True}))
    except Exception as e:
        print(json.dumps({"loaded": False, "error": str(e)}))
        sys.exit(2)


def _mam_cmd(argv):
    dev = argv[1] if len(argv) > 1 else "/dev/nst0"
    try:
        print(json.dumps(mam_snapshot(dev)))
    except Exception as e:
        print(json.dumps({"error": str(e)}))
        sys.exit(2)


