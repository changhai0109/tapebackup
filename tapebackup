def cmd_find(ctx, args):
    show_all = any(a in ("--all", "-a") for a in args)
    args = [a for a in args if a not in ("--all", "-a")]
    if not args:
        die("usage: find [--all] PATTERN")
    c = db_open(ctx)
    pat = "%" + args[0] + "%"
    base = """
      SELECT f.path, f.size, f.mtime, s.started, s.host_name, st.tape, st.file_no, s.sid,
             COUNT(*) OVER (PARTITION BY s.host_name, f.path) AS vcount,
             ROW_NUMBER() OVER (PARTITION BY s.host_name, f.path
                                ORDER BY s.started DESC, s.sid DESC) AS rn
      FROM file_index f JOIN sessions s ON s.sid=f.sid
      LEFT JOIN session_tapes st ON st.sid=f.sid AND st.seq=1
      WHERE f.path LIKE ?
    """
    q = ("SELECT * FROM (%s) ORDER BY path, started DESC LIMIT 500" % base) if show_all \
        else ("SELECT * FROM (%s) WHERE rn=1 ORDER BY path LIMIT 500" % base)
    rows = c.execute(q, (pat,)).fetchall()
    c.close()
    if not rows:
        print("(no match)")
        return
    print("%-10s %-19s %-10s %-4s %-24s %s" % ("host", "backup time", "size", "ver", "tape", "path"))
    for path, size, mt, started, host, tape, fno, sid, vc, rn in rows:
        mts = time.strftime("%Y-%m-%d", time.localtime(mt)) if mt else "-"
        print("%-10s %-19s %-10s %-4s %-24s %s  (mtime %s)" % (
            host, started, human(size), "x%d" % vc if vc > 1 else "",
            tape or "-", path, mts))


def cmd_extract(ctx, args):
    dest = None
    sid = None
    runid = None
    at = None
    paths = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-C":
            dest = args[i + 1]
            i += 2
        elif a == "--sid":
            sid = args[i + 1]
            i += 2
        elif a == "--run":
            runid = args[i + 1]
            i += 2
        elif a == "--at":
            at = args[i + 1]
            i += 2
        else:
            paths.append(a)
            i += 1
    if not dest or not os.path.isdir(dest):
        die("usage: extract -C DESTDIR [--sid N | PATH...]")
    c = db_open(ctx)
    if runid:
        rows = c.execute(
            "SELECT s.sid, st.tape, st.file_no FROM sessions s"
            " JOIN session_tapes st ON st.sid=s.sid AND st.seq=1"
            " WHERE s.run_id LIKE ? ORDER BY s.chunk_seq", (runid + "%",)).fetchall()
        c.close()
        if not rows:
            die("no sessions for run %s" % runid)
        cur = None
        for sid_r, tape, fno in rows:
            if tape != cur:
                if cur is not None:
                    ctx.mt_try("offline")
                    print("insert tape %s, press ENTER: " % tape, end="", flush=True)
                    sys.stdin.readline()
                cur = tape
            ctx.ensure_ready()
            pos_file(ctx, fno)
            if ctx.rhost:
                r1, r2 = ctx.stream_read(dest)
                if r2 not in (0, 1):
                    die("tar extract failed (%d) for session %s" % (r2, sid_r[:8]))
            else:
                r = ctx.tar(["-x", "-C", dest], check=False)
                if r.returncode not in (0, 1):
                    die("tar extract failed (%d)" % r.returncode)
        print("extracted run %s into %s" % (runid[:8], dest))
        return
    if sid:
        row = c.execute("SELECT sid FROM sessions WHERE sid LIKE ?", (sid + "%",)).fetchone()
        if not row:
            die("no session matching %s" % sid)
        sid = row[0]
    else:
        if not paths:
            die("give --sid N or PATHs")
        sids = set()
        for p in paths:
            pp = p.lstrip("/")
            if at:
                row = c.execute(
                    "SELECT s.sid, s.started, count(*) FROM file_index f"
                    " JOIN sessions s ON s.sid=f.sid WHERE f.path=? AND s.started<=?"
                    " GROUP BY s.sid ORDER BY s.started DESC LIMIT 1", (pp, at)).fetchone()
            else:
                row = c.execute(
                    "SELECT s.sid, s.started, count(*) FROM file_index f"
                    " JOIN sessions s ON s.sid=f.sid WHERE f.path=?"
                    " GROUP BY s.sid ORDER BY s.started DESC LIMIT 1", (pp,)).fetchone()
            if not row:
                die("path not in index%s: %s" % ((" at/ before " + at) if at else "", p))
            nver = c.execute("SELECT count(DISTINCT sid) FROM file_index WHERE path=?",
                             (pp,)).fetchone()[0]
            if nver > 1 and not at:
                print("note: %d versions of %s; using latest (%s). Use --sid/--at for another."
                      % (nver, p, row[1]))
            sids.add(row[0])
        if len(sids) > 1:
            die("the given paths belong to different sessions; extract them separately or use --sid")
        sid = sids.pop()
    tapes = c.execute("SELECT seq,tape,file_no FROM session_tapes WHERE sid=? ORDER BY seq",
                      (sid,)).fetchall()
    c.close()
    if not tapes:
        die("session has no tape records")
    first_file = tapes[0][2]
    ctx.ensure_ready()
    if ctx.dry:
        print("[dry-run] would seek to file %d of tape %s and tar -x %d file(s)"
              % (first_file, tapes[0][1], len(tapes)))
        return
    ctx.lock()
    try:
        pos_file(ctx, first_file)
        base_argv, _ = ctx.tar_argv()
        if ctx.rhost and len(tapes) == 1:
            r1, r2 = ctx.stream_read(dest, paths)
            if r2 not in (0, 1):
                die("tar extract failed (%d)" % r2)
        elif len(tapes) == 1:
            cmd = base_argv + ["-b%d" % BS, "-C", dest, "-x"] + paths
            r = run(cmd, check=False)
            if r.returncode not in (0, 1):
                die("tar extract failed (%d)" % r.returncode)
        else:
            tmp = tempfile.mkdtemp(prefix="tbrd.")
            lbl = os.path.join(tmp, "labels.txt")
            with open(lbl, "w") as f:
                for _, tape, _ in tapes[1:]:
                    f.write("%s\n" % tape)
            sw = os.path.join(tmp, "switch.sh")
            gen_switch_script(ctx, sw, os.path.join(tmp, "unused"), "read")
            os.rename(lbl, os.path.join(tmp, "unused.lbl"))
            cmd = base_argv + ["-b%d" % BS, "-M", "-F", sw, "-C", dest, "-x"] + paths
            r = run(cmd, check=False)
            subprocess.run(["rm", "-rf", tmp])
            if r.returncode not in (0, 1):
                die("tar extract failed (%d)" % r.returncode)
    finally:
        ctx.unlock()
    print("extracted into %s" % dest)


