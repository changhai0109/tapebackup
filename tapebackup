#!/usr/bin/env python3
# tapebackup v2 — LTO backup with a SQLite index, MAM-aware tape identity,
# multivolume tar spanning, on-tape TSV index blocks, dry-run, remote drive support.
#
# Model:
#   - Index DB lives on the ISSUING host (~/tapebackup/index.db).
#   - Tape identity comes from MAM: canonical id "MANUFACTURER:SERIAL".
#     Human label = MAM barcode (0x0806) when present.
#   - Tape layout (per tape):
#       file 1      : TAPEHDR/README.txt        (only on session-start tape)
#       file 2..k   : tar data archives         (may span to next tape at file 1)
#       last file   : TAPEIDX.<n>/...           (TSV index block, append-log)
#   - On-tape index blocks are a superseding append-log: rebuild = replay in
#     tape order, later rows win (per-key). No fixed reservation, no seeks.
#
# Environment:
#   TAPEBACKUP_DIR       default ~/tapebackup
#   TAPEBACKUP_DEV       default /dev/nst0
#   TAPEBACKUP_RHOST     remote drive host (uses ssh+rmt); empty = local drive
#   TAPEBACKUP_RPORT     ssh port for remote host
#   TAPEBACKUP_RUSER     ssh user
#   TAPEBACKUP_RDEV      remote device, default /dev/nst0
#   TAPEBACKUP_VOL_KIB   per-volume size for tar -L (KiB), default 2400000

import argparse
import ctypes
import fcntl
import getpass
import json
import os
import re
import shlex
