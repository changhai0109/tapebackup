def parse_size(v):
    v = str(v).strip().upper()
    m = re.match(r"^([0-9.]+)\s*([KMGT]?)(I?B?)$", v)
    if not m:
        die("bad size: %s" % v)
    mult = {"": 1, "K": 1024, "M": 1024 ** 2, "G": 1024 ** 3, "T": 1024 ** 4}[m.group(2)]
    return int(float(m.group(1)) * mult)


def build_manifest(sources):
    files = []
    for src in sources:
        if os.path.isdir(src):
            for root, dirs, fs in os.walk(src):
                dirs.sort()
                fs.sort()
                for fn in fs:
                    fp = os.path.join(root, fn)
                    try:
                        stt = os.lstat(fp)
                    except OSError:
                        continue
                    if not stat.S_ISREG(stt.st_mode):
                        continue
                    files.append((fp, stt.st_size, int(stt.st_mtime)))
        elif os.path.exists(src):
            stt = os.stat(src)
            files.append((src, stt.st_size, int(stt.st_mtime)))
        else:
            die("no such path: %s" % src)
    files.sort()
    return files


def split_chunks(files, chunk_bytes):
    chunks, cur, cur_sz = [], [], 0
    for fp, sz, mt in files:
        if cur and cur_sz + sz > chunk_bytes:
            chunks.append(cur)
            cur, cur_sz = [], 0
        cur.append((fp, sz, mt))
        cur_sz += sz
    if cur:
        chunks.append(cur)
    return chunks


def write_header(ctx, tmp, cid, barcode):
    hdr = os.path.join(tmp, "hdr")
    os.makedirs(os.path.join(hdr, "TAPEHDR"), exist_ok=True)
    with open(os.path.join(hdr, "TAPEHDR", "README.txt"), "w") as f:
        f.write("tapebackup v3 tape\n")
        f.write("canonical id: %s\n" % cid)
        f.write("barcode: %s\n" % barcode)
        f.write("created: %s\n" % time.strftime("%Y-%m-%d %H:%M:%S"))
        f.write("created by: %s (%s)\n" % (ctx.host_name, ctx.host_uuid))
        f.write("\nData is stored as tar chunks; each chunk is followed by a TAPEIDX block.\n")
        f.write("Recover with: tapebackup scan\n")
    if ctx.rhost:
        r1, r2 = ctx.stream_write(["TAPEHDR"], cwd=hdr)
        if r2 != 0 or r1 not in (0, 1):
            die("failed to write tape header (tar %s, dd %s)" % (r1, r2))
    else:
        ctx.tar(["-c", "-C", hdr, "TAPEHDR"])


def eom_probe(ctx):
    """Seek to end of recorded data and report where the tail is.

    Returns (next_writable_file, last_file_number, partial) where
    last_file_number is 0-based (== number of complete files) and partial
    means the tail was mid-file and we closed it with a filemark."""
    ctx.mt("rewind")
    if not ctx.mt_try("eom"):
        return None

    def _status():
        out = ctx.mt("status")
        fn = re.search(r"file number\s*=\s*(\d+)", out or "")
        bn = re.search(r"block number\s*=\s*(-?\d+)", out or "")
        return (int(fn.group(1)) if fn else None,
                int(bn.group(1)) if bn else None)

    fn, bn = _status()
    if fn is None:
        return None
    if bn == 0:
        return fn + 1, fn, False
    if not ctx.mt_try("weof", "1"):
        return None
    fn2, _ = _status()
    fn2 = fn2 if fn2 is not None else fn + 1
    return fn2 + 1, fn2, True


def tape_state_full(ctx, mam):
    state = tape_state(mam)
    try:
        if read_sig(ctx, 1).startswith(b"TAPEHDR/"):
            state = "tapebackup"
    except SystemExit:
        pass
    return state


def write_chunk(ctx, run_id, seq, n_chunks, chunk_files, chunk_bytes, force):
    """Write one chunk: tar file + its own index block, commit DB, release lock."""
    ctx.lock()
    tmp = tempfile.mkdtemp(prefix="tbchunk.")
    try:
        ctx.ensure_ready()
        mam = tape_id(ctx)
        cid = mam.get("canonical_id") or ""
        if not cid:
            die("tape has no MAM identity")
        barcode = mam.get("barcode") or ""
        state = tape_state_full(ctx, mam)
        need = sum(sz for _, sz, _ in chunk_files)
        rem = (mam.get("remaining_mb") or 0) * 1024 * 1024
        if rem and rem < need + (1 << 30):
            print("tape nearly full: remaining %s, chunk needs %s"
                  % (human(rem), human(need)), flush=True)
            ctx.mt_try("offline")
            print("Insert a NEW tape, then press ENTER: ", end="", flush=True)
            sys.stdin.readline()
            ctx.ensure_ready()
            mam = tape_id(ctx)
            cid = mam.get("canonical_id") or ""
            barcode = mam.get("barcode") or ""
            state = tape_state_full(ctx, mam)
            if not cid:
                die("cannot identify the new tape")
            if state not in ("blank",):
                if not force:
                    die("new tape is not blank (%s); rerun with --force to overwrite it" % state)
        if state == "tapebackup":
            c0 = db_open(ctx)
            row = c0.execute("SELECT max(file_no) FROM session_tapes WHERE tape=?",
                             (cid,)).fetchone()
            c0.close()
            next_file = (row[0] + 2) if (row and row[0]) else 2
            prev_block = (next_file - 1) if next_file > 2 else None
            pos_file(ctx, next_file)
            positioned = False
            if read_cur(ctx):
                # unindexed data sits in the slot we wanted to use (partial chunk)
                warn("found unindexed data at file %d; locating tape end ..." % next_file)
                probe = eom_probe(ctx)
                if probe is None:
                    die("cannot determine the end of recorded data")
                nf_eod, last_fn, partial = probe
                tail_index = last_fn + 1 if partial else last_fn
                if tail_index == next_file:
                    # the unindexed partial chunk is the last file: truncate & reuse
                    print("reclaiming partial chunk at file %d (quick erase) ..."
                          % next_file, flush=True)
                    pos_file(ctx, next_file)
                    ctx.sg_erase(long=False)
                    positioned = True   # already at the reclaimed position
                else:
                    warn("valid data exists after the partial chunk; appending at file %d"
                         % nf_eod)
                    next_file = nf_eod
                    prev_block = None
                    positioned = True   # eom left us at end of data
        elif state == "blank" or force:
            ctx.mt("rewind")
            write_header(ctx, tmp, cid, barcode)
            next_file = 2
            prev_block = None
        else:
            die("tape contains %s data; use --force to overwrite" % state)

        listf = os.path.join(tmp, "chunk.list")
        with open(listf, "wb") as f:
            for fp, _, _ in chunk_files:
                f.write(fp.encode("utf-8", "surrogateescape") + b"\0")
        if not locals().get("positioned"):
            pos_file(ctx, next_file)
        positioned = False
        t0 = time.time()
        if ctx.rhost:
            r1, r2 = ctx.stream_write(listfile=listf)
            if r2 != 0:
                die("remote dd failed (%d)" % r2)
            if r1 not in (0, 1):
                die("tar failed (%d)" % r1)
        else:
            r = ctx.tar(["-c", "--null", "-T", listf], check=False)
            if r.returncode not in (0, 1):
                die("tar failed (%d)" % r.returncode)
        dt = time.time() - t0
        size = need
        print("[chunk %d/%d] %s in %d files -> tape %s file %d (%.0fs, %s/s)"
              % (seq, n_chunks, human(size), len(chunk_files), cid, next_file, dt,
                 human(size / dt if dt else 0)), flush=True)

        sid = uuid4()
        now = time.strftime("%Y-%m-%d %H:%M:%S")
        c = db_open(ctx)
        c.execute("INSERT OR IGNORE INTO tapes(cid,barcode,created,created_by)"
                  " VALUES(?,?,?,?)",
                  (cid, barcode, now, "%s (%s)" % (ctx.host_name, ctx.host_uuid)))
        c.execute("INSERT INTO sessions(sid,host_uuid,host_name,started,finished,paths,"
                  "est_size,est_files,status,run_id,chunk_seq)"
                  " VALUES(?,?,?,?,?,?,?,?,?,?,?)",
                  (sid, ctx.host_uuid, ctx.host_name, now, now,
                   "chunk %d/%d of run %s" % (seq, n_chunks, run_id[:8]),
                   size, len(chunk_files), 1, run_id, seq))
        c.execute("INSERT INTO session_tapes VALUES(?,?,?,?)", (sid, 1, cid, next_file))
        c.executemany("INSERT OR REPLACE INTO file_index(sid,path,size,mtime)"
                      " VALUES(?,?,?,?)",
                      [(sid, fp.lstrip("/"), sz, mt) for fp, sz, mt in chunk_files])
        c.commit()
        c.close()

        blk_no = next_file + 1
        bdir = block_dump(ctx, tmp, cid, barcode, blk_no, prev_block)
        try:
            if bdir:
                name = os.path.basename(bdir)
                if ctx.rhost:
                    r1, r2 = ctx.stream_write([name], cwd=tmp)
                    if r2 != 0 or r1 not in (0, 1):
                        die("failed to write index block (tar %s, dd %s)" % (r1, r2))
                else:
                    ctx.tar(["-c", "-C", tmp, name])
        except SystemExit:
            c = db_open(ctx)
            c.execute("DELETE FROM file_index WHERE sid=?", (sid,))
            c.execute("DELETE FROM session_tapes WHERE sid=?", (sid,))
            c.execute("DELETE FROM sessions WHERE sid=?", (sid,))
            c.commit()
            c.close()
            raise
        return sid, cid, next_file
    finally:
        subprocess.run(["rm", "-rf", tmp])
        ctx.unlock()


def cmd_write(ctx, args):
    force = "--force" in args
    args = [a for a in args if a != "--force"]
    chunk_bytes = 50 * 1024 ** 3
    cooldown = 0
    if "--cooldown" in args:
        i = args.index("--cooldown")
        cooldown = int(args[i + 1])
        del args[i:i + 2]
    if "--rate" in args:
        i = args.index("--rate")
        ctx.rate = int(float(args[i + 1]) * 1024 * 1024)
        del args[i:i + 2]
    if "--chunk-size" in args:
        i = args.index("--chunk-size")
        chunk_bytes = parse_size(args[i + 1])
        del args[i:i + 2]
    label_override = None
    if "--label" in args:
        i = args.index("--label")
        label_override = args[i + 1]
        del args[i:i + 2]
    if not args:
        die("usage: write [--force] [--chunk-size 50G] SRC...")
    files = build_manifest(args)
    if not files:
        die("nothing to back up")
    chunks = split_chunks(files, chunk_bytes)
    total = sum(sz for _, sz, _ in files)
    run_id = uuid4()
    plan_dir = os.path.join(ctx.dir, "runs", run_id)
    os.makedirs(plan_dir, exist_ok=True)
    with open(os.path.join(plan_dir, "plan.tsv"), "w") as f:
        for seq, chunk in enumerate(chunks, 1):
            for fp, sz, mt in chunk:
                f.write("%d\t%s\t%d\t%d\n" % (seq, esc(fp), sz, mt))
    print("run %s: %s in %d files -> %d chunk(s), chunk size %s"
          % (run_id[:8], human(total), len(files), len(chunks), human(chunk_bytes)))
    if ctx.dry:
        for seq, chunk in enumerate(chunks, 1):
            print("[dry-run] chunk %d/%d: %s in %d files"
                  % (seq, len(chunks), human(sum(s for _, s, _ in chunk)), len(chunk)))
        print("[dry-run] would lock/unlock per chunk and write %d index blocks"
              % len(chunks))
        return
    db_init(ctx)
    c = db_open(ctx)
    c.execute("INSERT OR REPLACE INTO runs VALUES(?,?,?,?,?,?,?)",
              (run_id, time.strftime("%Y-%m-%d %H:%M:%S"), None,
               " ".join(args), chunk_bytes, len(chunks), 0))
    c.commit()
    c.close()
    for seq, chunk in enumerate(chunks, 1):
        if seq > 1 and cooldown:
            print("cooldown %ds before chunk %d ..." % (cooldown, seq), flush=True)
            time.sleep(cooldown)
        write_chunk(ctx, run_id, seq, len(chunks), chunk, chunk_bytes, force)
    c = db_open(ctx)
    c.execute("UPDATE runs SET finished=?, status=1 WHERE run_id=?",
              (time.strftime("%Y-%m-%d %H:%M:%S"), run_id))
    c.commit()
    c.close()
    print("run %s complete: %d chunk(s)" % (run_id[:8], len(chunks)))


def cmd_resume(ctx, args):
    force = "--force" in sys.argv
    args = [a for a in args if a not in ("--force",)]
    cooldown = 0
    if "--cooldown" in args:
        i = args.index("--cooldown")
        cooldown = int(args[i + 1])
        del args[i:i + 2]
    if "--rate" in args:
        i = args.index("--rate")
        ctx.rate = int(float(args[i + 1]) * 1024 * 1024)
        del args[i:i + 2]
    if not args:
        die("usage: resume RUN_ID [--force] [--rate MBps] [--cooldown SEC]")
    rid = args[0]
    c = db_open(ctx)
    row = c.execute("SELECT run_id,chunk_bytes,n_chunks,status FROM runs WHERE run_id LIKE ?",
                    (rid + "%",)).fetchone()
    if not row:
        c.close()
        die("no such run: %s" % rid)
    run_id, chunk_bytes, n_chunks, status = row
    if status == 1:
        c.close()
        print("run %s already complete" % run_id[:8])
        return
    done = {r[0] for r in c.execute(
        "SELECT chunk_seq FROM sessions WHERE run_id=? AND status=1", (run_id,))}
    c.close()
    plan_file = os.path.join(ctx.dir, "runs", run_id, "plan.tsv")
    if not os.path.exists(plan_file):
        die("missing plan: %s" % plan_file)
    chunks = {}
    for line in open(plan_file):
        line = line.rstrip("\n")
        if not line:
            continue
        parts = line.split("\t")
        seq, fp, sz = parts[0], parts[1], parts[2]
        mt = int(parts[3]) if len(parts) > 3 else None
        chunks.setdefault(int(seq), []).append((unesc(fp), int(sz), mt))
    for seq in sorted(chunks):
        if seq in done:
            print("[chunk %d/%d] already complete, skipping" % (seq, n_chunks))
            continue
        if cooldown:
            print("cooldown %ds before chunk %d ..." % (cooldown, seq), flush=True)
            time.sleep(cooldown)
        write_chunk(ctx, run_id, seq, n_chunks, chunks[seq], chunk_bytes, force)
    c = db_open(ctx)
    c.execute("UPDATE runs SET finished=?, status=1 WHERE run_id=?",
              (time.strftime("%Y-%m-%d %H:%M:%S"), run_id))
    c.commit()
    c.close()
    print("run %s complete" % run_id[:8])


