import uuid

BS = 2048  # 1 MiB tar blocks: fewer rmt round-trips over high-latency links
DEFAULT_VOL_KIB = 2400000000   # KiB -> ~2.23 TiB (tar -L unit is KiB)
SELF = os.path.abspath(__file__)

# ---------------------------------------------------------------- utilities


_T0 = time.time()


def tick(tag):
    if os.environ.get("TAPEBACKUP_TIMING"):
        print("[t %6.2fs] %s" % (time.time() - _T0, tag), flush=True)


def die(msg):
    print("ERROR: %s" % msg, file=sys.stderr)
    sys.exit(1)


def warn(msg):
    print("WARNING: %s" % msg, file=sys.stderr)


def run(cmd, check=True, input=None, tty=False, timeout=None):
    if tty:
        return subprocess.run(cmd, input=input, text=True, timeout=timeout)
    r = subprocess.run(cmd, input=input, text=True, capture_output=True,
                       timeout=timeout)
    if check and r.returncode != 0:
        sys.stderr.write(r.stdout or "")
        sys.stderr.write(r.stderr or "")
        die("command failed (%d): %s" % (r.returncode, " ".join(map(str, cmd))))
    return r


def human(n):
    if n is None:
        return "?"
    n = float(n)
    for u in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or u == "TiB":
            return ("%.1f %s" % (n, u)) if u != "B" else ("%d B" % n)
        n /= 1024.0


def esc(s):
    return str(s).replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n")


def unesc(s):
    out, i = [], 0
    while i < len(s):
        c = s[i]
        if c == "\\" and i + 1 < len(s):
            nxt = s[i + 1]
            out.append({"t": "\t", "n": "\n", "\\": "\\"}.get(nxt, nxt))
            i += 2
        else:
            out.append(c)
            i += 1
    return "".join(out)


def uuid4():
    try:
        with open("/proc/sys/kernel/random/uuid") as f:
            return f.read().strip()
    except OSError:
        return str(uuid.uuid4())


# ---------------------------------------------------------------- MAM (SG_IO)

SG_IO = 0x2285
SG_DXFER_FROM_DEV = -3
SG_DXFER_NONE = -1


class SgIoHdr(ctypes.Structure):
    _fields_ = [
        ("interface_id", ctypes.c_int),
        ("dxfer_direction", ctypes.c_int),
        ("cmd_len", ctypes.c_ubyte),
        ("mx_sb_len", ctypes.c_ubyte),
        ("iovec_count", ctypes.c_ushort),
        ("dxfer_len", ctypes.c_uint),
        ("dxferp", ctypes.c_void_p),
        ("cmdp", ctypes.c_void_p),
        ("sbp", ctypes.c_void_p),
        ("timeout", ctypes.c_uint),
        ("flags", ctypes.c_uint),
        ("pack_id", ctypes.c_int),
        ("usr_ptr", ctypes.c_void_p),
        ("status", ctypes.c_ubyte),
        ("masked_status", ctypes.c_ubyte),
        ("msg_status", ctypes.c_ubyte),
        ("sb_len_wr", ctypes.c_ubyte),
        ("host_status", ctypes.c_ushort),
        ("driver_status", ctypes.c_ushort),
        ("resid", ctypes.c_int),
        ("duration", ctypes.c_uint),
        ("info", ctypes.c_uint),
    ]


MAM_NAMES = {
    0x0000: "remaining_mb", 0x0001: "max_mb", 0x0002: "tapealert",
    0x0003: "load_count", 0x0005: "assign_org", 0x0006: "formatted_density",
    0x0007: "init_count", 0x0008: "volume_id", 0x0009: "vcr",
    0x020A: "last_drive_id", 0x0220: "lifetime_written_mb",
    0x0221: "lifetime_read_mb",
    0x0400: "manufacturer", 0x0401: "medium_serial", 0x0404: "medium_assign_org",
    0x0405: "medium_density", 0x0406: "manuf_date", 0x0407: "mam_capacity",
    0x0408: "medium_type", 0x0800: "app_vendor", 0x0801: "app_name",
    0x0802: "app_version", 0x0803: "volume_label", 0x0806: "barcode",
    0x080B: "app_format_version", 0x080C: "vci", 0x0820: "ltfs_uuid",
    0x1000: "uci", 0x1001: "auci", 0x1623: "volume_locked",
}

ASCII_ATTRS = {0x0005, 0x0008, 0x0400, 0x0401, 0x0404, 0x0406, 0x0806,
               0x0800, 0x0801, 0x0802, 0x080B, 0x020A, 0x020B, 0x020C, 0x020D}


def sg_issue(fd, cdb, alloc, direction=SG_DXFER_FROM_DEV, timeout_ms=60000):
    buf = ctypes.create_string_buffer(alloc)
    sb = ctypes.create_string_buffer(64)
    cdb_buf = ctypes.create_string_buffer(bytes(cdb), len(cdb))
    hdr = SgIoHdr()
    hdr.interface_id = ord("S")
    hdr.dxfer_direction = direction
    hdr.cmd_len = len(cdb)
    hdr.mx_sb_len = 64
    hdr.dxfer_len = alloc
    hdr.dxferp = ctypes.cast(buf, ctypes.c_void_p)
    hdr.cmdp = ctypes.cast(cdb_buf, ctypes.c_void_p)
    hdr.sbp = ctypes.cast(sb, ctypes.c_void_p)
    hdr.timeout = timeout_ms
    fcntl.ioctl(fd, SG_IO, hdr)
    if hdr.status != 0:
        return None, bytes(sb.raw[: hdr.sb_len_wr or 0])
    got = alloc - hdr.resid
    return buf.raw[:got], b""


def sg_read_attributes(sgpath, service_action, first=0, alloc=8192, cache=1):
    cdb = bytearray(16)
    cdb[0] = 0x8C
    cdb[1] = service_action & 0x1F
    cdb[8] = (first >> 8) & 0xFF
    cdb[9] = first & 0xFF
    cdb[10:14] = alloc.to_bytes(4, "big")
    cdb[14] = cache & 0x01
    fd = os.open(sgpath, os.O_RDWR)
    try:
        return sg_issue(fd, cdb, alloc)
    finally:
        os.close(fd)


def mam_attrs(sgpath):
    data, sense = sg_read_attributes(sgpath, 0x00, 0, 8192)
    if data is None:
        raise RuntimeError("READ ATTRIBUTE SA=0 failed (sense %s)" % sense.hex())
    avail = int.from_bytes(data[0:4], "big")
    attrs = {}
    i = 4
    end = min(len(data), 4 + avail)
    while i + 5 <= end:
        aid = int.from_bytes(data[i:i + 2], "big")
        ln = int.from_bytes(data[i + 3:i + 5], "big")
        attrs[aid] = data[i + 5:i + 5 + ln]
        i += 5 + ln
    return attrs


def sg_name_for_st(stdev):
    base = os.path.basename(os.path.realpath(stdev))
    for cand in (base, base.replace("nst", "st")):
        d = "/sys/class/scsi_tape/%s/device/scsi_generic" % cand
        if os.path.isdir(d):
            names = sorted(os.listdir(d))
            if names:
                return "/dev/" + names[0]
    raise RuntimeError("cannot find sg node for %s" % stdev)


def sg_tur(fd):
    data, sense = sg_issue(fd, bytes(6), 0, SG_DXFER_NONE)
    return (data is not None), sense


def drive_wait_ready(stdev, timeout=150):
    """Ensure medium is loaded/ready; auto-issues LOAD if needed."""
    sg = sg_name_for_st(stdev)
    fd = os.open(sg, os.O_RDWR)
    try:
        ok, sense = sg_tur(fd)
        if not ok:
            key = (sense[2] & 0x0F) if len(sense) > 2 else 0
            asc = sense[12] if len(sense) > 12 else 0
            if key == 0x02 and asc == 0x3A:
                return False, "no cartridge present"
            sg_issue(fd, bytes([0x1B, 0, 0, 0, 1, 0]), 0, SG_DXFER_NONE)   # LOAD
            deadline = time.time() + timeout
            while time.time() < deadline:
                time.sleep(5)
                ok, sense = sg_tur(fd)
                if ok:
                    break
            if not ok:
                return False, "medium not ready (sense %s)" % sense.hex()
        return True, ""
    finally:
        os.close(fd)


def sg_erase_dev(stdev, long=False):
    sg = sg_name_for_st(stdev)
    fd = os.open(sg, os.O_RDWR)
    try:
        cdb = bytes([0x19, 1 if long else 0, 0, 0, 0, 0])
        data, sense = sg_issue(fd, cdb, 0, SG_DXFER_NONE, timeout_ms=7200000)
        return data is not None, sense
    finally:
        os.close(fd)


def mam_snapshot(stdev):
    sg = sg_name_for_st(stdev)
    attrs = mam_attrs(sg)
    out = {}
    for aid, name in MAM_NAMES.items():
        if aid not in attrs:
            continue
        raw = attrs[aid]
        if aid in ASCII_ATTRS:
            out[name] = raw.decode("ascii", "replace").strip("\x00 ").strip()
        elif aid in (0x0000, 0x0001, 0x0220, 0x0221, 0x0003, 0x0007, 0x0407):
            out[name] = int.from_bytes(raw, "big")
        elif aid == 0x0803:
            txt = "".join(chr(c) if 32 <= c < 127 else "" for c in raw)
            out[name] = txt.strip()
        elif aid == 0x080C and len(raw) >= 24:
            out["vci_gen"] = int.from_bytes(raw[8:16], "big")
            out["vci_block"] = int.from_bytes(raw[16:24], "big")
            m = re.search(rb"([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", raw)
            if m:
                out["ltfs_uuid"] = m.group(1).decode()
        else:
            out[name] = raw.hex()
    m = out.get("manufacturer") or ""
    s = out.get("medium_serial") or ""
    out["canonical_id"] = ("%s:%s" % (m, s)) if (m and s) else ""
    return out


# ---------------------------------------------------------------- context


class Ctx:
    def __init__(self, dry=False):
        self.dir = os.path.expanduser(os.environ.get("TAPEBACKUP_DIR", "~/tapebackup"))
        self.dbpath = os.path.join(self.dir, "index.db")
        self.dev = os.environ.get("TAPEBACKUP_DEV", "/dev/nst0")
        self.rhost = os.environ.get("TAPEBACKUP_RHOST", "")
        self.rport = os.environ.get("TAPEBACKUP_RPORT", "")
        self.ruser = os.environ.get("TAPEBACKUP_RUSER", "")
        self.rdev = os.environ.get("TAPEBACKUP_RDEV", "/dev/nst0")
        self.vol_kib = int(os.environ.get("TAPEBACKUP_VOL_KIB", DEFAULT_VOL_KIB))
        self.rmt = os.environ.get("TAPEBACKUP_RMT", "/usr/sbin/rmt")
        self.dry = dry
        self.rate = 0
        self.host_uuid = self._machine_id()
        self.host_name = self._host_name()
        self._locks = []
        self.rhost_tar = None
        self.ruser_eff = None

    # ----- identity
    @staticmethod
    def _machine_id():
        for p in ("/etc/machine-id", "/var/lib/dbus/machine-id"):
            try:
                with open(p) as f:
                    v = f.read().strip()
                    if v:
                        return v
            except OSError:
                pass
        return socket.gethostname()

    def _host_name(self):
        try:
            with open(os.path.join(self.dir, "host.conf")) as f:
                for line in f:
                    if line.startswith("host_name="):
                        return line.split("=", 1)[1].strip()
        except OSError:
            pass
        return socket.gethostname()

    # ----- ssh
    def _ssh_base(self, mux=False):
        a = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
             "-c", "aes128-gcm@openssh.com"]
        if mux:
            a += ["-o", "ControlMaster=auto",
                  "-o", "ControlPath=/tmp/tapebackup-ssh-%r@%h:%p",
                  "-o", "ControlPersist=600"]
        if self.rport:
            a += ["-p", str(self.rport)]
        if self.ruser:
            a += ["-l", self.ruser]
        a.append(self.rhost)
        return a

    def ssh_argv(self):
        return self._ssh_base(mux=True)

    def ssh_argv_stream(self):
        return self._ssh_base(mux=False)

    def drive_run(self, local_argv, remote_cmd):
        """Run a drive-host command; returns CompletedProcess."""
        if self.dry:
            shown = remote_cmd if self.rhost else " ".join(map(str, local_argv))
            print("[dry-run] drive: %s" % shown)
            return subprocess.CompletedProcess([], 0, "", "")
        if self.rhost:
            return run(self.ssh_argv() + [remote_cmd])
        return run(local_argv)

    # ----- mt
    def mt(self, *args, check=True):
        a = [str(x) for x in args]
        if self.rhost:
            cmd = "sudo mt -f %s %s" % (shlex.quote(self.rdev),
                                        " ".join(shlex.quote(x) for x in a))
            if self.dry:
                print("[dry-run] drive: %s" % cmd)
                return ""
            r = run(self.ssh_argv() + [cmd], check=check, timeout=1800)
        else:
            if self.dry:
                print("[dry-run] mt -f %s %s" % (self.dev, " ".join(a)))
                return ""
            r = run(["sudo", "mt", "-f", self.dev] + a, check=check, timeout=1800)
        return r.stdout

    def mt_try(self, *args):
        try:
            self.mt(*args, check=True)
            return True
        except SystemExit:
            return False

    # ----- tar
    def prep_remote(self):
        """Resolve the real hostname (tar needs DNS) and build an ssh wrapper
        that works when tar runs under sudo (tar's rsh needs root to drop privs)."""
        if self.rhost_tar:
            return
        host, user = self.rhost, self.ruser
        r = run(["ssh", "-G", self.rhost], check=False)
        for line in r.stdout.splitlines():
            if line.startswith("hostname "):
                host = line.split(None, 1)[1].strip()
            elif line.startswith("user ") and not user:
                user = line.split(None, 1)[1].strip()
        self.rhost_tar = host
        self.ruser_eff = user or getpass.getuser()
        if run(["sudo", "-n", "true"], check=False).returncode != 0:
            die("remote mode needs passwordless sudo locally (tar's rmt requires root)")
        home = os.path.expanduser("~")
        key = None
        for k in ("id_ed25519", "id_rsa", "id_ecdsa"):
            cand = os.path.join(home, ".ssh", k)
            if os.path.exists(cand):
                key = cand
                break
        opts = ["-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new",
                "-c", "aes128-gcm@openssh.com",
                "-o", "ControlMaster=auto",
                "-o", "ControlPath=/tmp/tapebackup-ssh-%r@%h:%p",
                "-o", "ControlPersist=600"]
        if self.rport:
            opts += ["-p", str(self.rport)]
        opts += ["-l", self.ruser_eff]
        if key:
            opts += ["-i", key, "-o", "IdentitiesOnly=yes"]
        wrapper = os.path.join(self.dir, "rmtssh")
        os.makedirs(self.dir, exist_ok=True)
        content = "#!/bin/sh\nexec ssh %s \"$@\"\n" % " ".join(shlex.quote(o) for o in opts)
        try:
            old = open(wrapper).read()
        except OSError:
            old = None
        if old != content:
            with open(wrapper, "w") as f:
                f.write(content)
            os.chmod(wrapper, 0o755)
        self.rsh_wrapper = wrapper

    def tar_argv(self):
        if self.rhost:
            self.prep_remote()
            return ["sudo", "tar", "-f", "%s:%s" % (self.rhost_tar, self.rdev),
                    "--rsh-command=%s" % self.rsh_wrapper,
                    "--rmt-command=%s" % self.rmt], "remote"
        if os.access(self.dev, os.W_OK):
            return ["tar", "-f", self.dev], "local"
        return ["sudo", "tar", "-f", self.dev], "local"

    def stream_write(self, items=None, cwd=None, listfile=None):
        """tar -> [pv -L rate] -> ssh dd. Much faster than rmt on high-latency links."""
        cmd = ["tar", "-c", "-b%d" % BS]
        if listfile:
            cmd += ["--null", "-T", listfile]
        elif items:
            if cwd:
                cmd += ["-C", cwd]
            cmd += list(items)
        cmd += ["-f", "-"]
        dd = "sudo dd of=%s bs=1M iflag=fullblock 2>/dev/null" % shlex.quote(self.rdev)
        p1 = subprocess.Popen(cmd, stdout=subprocess.PIPE)
        src = p1.stdout
        pv = None
        rate = getattr(self, "rate", 0)
        if rate:
            pv = subprocess.Popen(["pv", "-q", "-B", "1M", "-L", str(int(rate))],
                                  stdin=src, stdout=subprocess.PIPE)
            src.close()
            src = pv.stdout
        p2 = subprocess.Popen(self.ssh_argv_stream() + [dd], stdin=src)
        src.close()
        rc2 = p2.wait()
        rcv = pv.wait() if pv else 0
        rc1 = p1.wait()
        if rcv not in (0, None):
            rc1 = rc1 or rcv
        return rc1, rc2

    def stream_read(self, dest, paths=()):
        """ssh dd -> tar -x. Returns (ssh_rc, tar_rc)."""
        dd = "sudo dd if=%s bs=1M iflag=fullblock 2>/dev/null" % shlex.quote(self.rdev)
        p1 = subprocess.Popen(self.ssh_argv_stream() + [dd], stdout=subprocess.PIPE)
        cmd = ["tar", "-x", "-b%d" % BS, "-C", dest, "-f", "-"] + list(paths)
        p2 = subprocess.Popen(cmd, stdin=p1.stdout)
        p1.stdout.close()
        rc2 = p2.wait()
        rc1 = p1.wait()
        return rc1, rc2

    def tar(self, args, check=True):
        base, _ = self.tar_argv()
        cmd = base + ["-b%d" % BS] + list(args)
        if self.dry:
            print("[dry-run] tar %s" % " ".join(shlex.quote(x) for x in cmd[1:]))
            return subprocess.CompletedProcess([], 0, "", "")
        return run(cmd, check=check)

    def sg_erase(self, long=False):
        src = open(SELF).read()
        mode = "long" if long else "quick"
        if self.rhost:
            argv = self.ssh_argv() + ["sudo python3 - _erase %s %s" % (shlex.quote(self.rdev), mode)]
        else:
            argv = ["sudo", "python3", "-", "_erase", self.dev, mode]
        r = run(argv, input=src, check=False, timeout=None)
        try:
            j = json.loads(r.stdout.strip().splitlines()[-1])
        except Exception:
            j = {"erased": False, "error": (r.stderr or r.stdout).strip()[:300]}
        if not j.get("erased"):
            die("erase failed: %s" % (j.get("error") or j.get("sense") or "unknown"))

    def _mt_probe(self, *args, timeout=25):
        try:
            if self.rhost:
                cmd = "sudo mt -f %s %s" % (shlex.quote(self.rdev),
                                            " ".join(shlex.quote(a) for a in args))
                r = run(self.ssh_argv() + [cmd], check=False, timeout=timeout)
            else:
                r = run(["sudo", "mt", "-f", self.dev] + list(args),
                        check=False, timeout=timeout)
            return r.returncode == 0
        except subprocess.TimeoutExpired:
            return False

    def _sg_load(self):
        src = open(SELF).read()
        if self.rhost:
            argv = self.ssh_argv() + ["sudo python3 - _load %s" % shlex.quote(self.rdev)]
        else:
            argv = ["sudo", "python3", "-", "_load", self.dev]
        run(argv, input=src, check=False)

    def ensure_ready(self):
        """Ensure the medium is loaded/ready using SG_IO only (no st open).

        Opening the st device while the drive is mid-load can wedge the driver,
        so the readiness probe must never touch /dev/nst*."""
        if self.dry:
            print("[dry-run] would ensure tape is loaded/ready")
            return
        src = open(SELF).read()
        if self.rhost:
            argv = self.ssh_argv() + ["sudo python3 - _ready %s" % shlex.quote(self.rdev)]
        else:
            argv = ["sudo", "python3", "-", "_ready", self.dev]
        r = run(argv, input=src, check=False, timeout=300)
        try:
            j = json.loads(r.stdout.strip().splitlines()[-1])
        except Exception:
            j = {"ready": False, "msg": (r.stderr or r.stdout).strip()[:200]}
        if not j.get("ready"):
            die("tape not ready: %s" % (j.get("msg") or j.get("error") or
                                        "no cartridge, or drive needs a power cycle"))

    # ----- db
    def db(self):
        os.makedirs(self.dir, exist_ok=True)
        c = sqlite3.connect(self.dbpath)
        c.execute("PRAGMA journal_mode=WAL")
        return c

    # ----- lock
    def lock(self):
        """flock held by a long-lived child; released automatically if we die."""
        if self.dry:
            print("[dry-run] would acquire drive lock")
            return
        lockpath = "/tmp/tapebackup.drive.lock" if self.rhost else os.path.join(self.dir, "drive.lock")
        inner = "flock -x -w 5 %s sh -c 'echo LOCKED; cat >/dev/null'" % shlex.quote(lockpath)
        if self.rhost:
            p = subprocess.Popen(self.ssh_argv() + [inner], stdin=subprocess.PIPE,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        else:
            os.makedirs(self.dir, exist_ok=True)
            p = subprocess.Popen(["flock", "-x", "-w", "5", lockpath,
                                  "sh", "-c", "echo LOCKED; cat >/dev/null"],
                                 stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                 stderr=subprocess.PIPE)
        line = p.stdout.readline()
        if line.strip() != b"LOCKED":
            try:
                p.kill()
            except Exception:
                pass
            die("drive is locked by another process")
        self._locks.append(("flock", p, None))

    def unlock(self):
        for item in self._locks:
            kind, obj, path = item
            if kind == "local":
                try:
                    fcntl.flock(obj, fcntl.LOCK_UN)
                    obj.close()
                except OSError:
                    pass
            elif kind == "flock":
                try:
                    obj.stdin.close()
                except Exception:
                    pass
                try:
                    obj.wait(timeout=5)
                except Exception:
                    try:
                        obj.terminate()
                    except Exception:
                        pass
            else:
                run(self.ssh_argv() + ["rm -f %s" % path], check=False)
        self._locks = []

# ---------------------------------------------------------------- schema

SCHEMA = """
CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT);
CREATE TABLE IF NOT EXISTS tapes(
  cid TEXT PRIMARY KEY, barcode TEXT, created TEXT, created_by TEXT, note TEXT);
CREATE TABLE IF NOT EXISTS runs(
  run_id TEXT PRIMARY KEY, started TEXT, finished TEXT, source TEXT,
  chunk_bytes INTEGER, n_chunks INTEGER, status INTEGER);
CREATE TABLE IF NOT EXISTS sessions(
  sid TEXT PRIMARY KEY, host_uuid TEXT, host_name TEXT,
  started TEXT, finished TEXT, paths TEXT,
  est_size INTEGER, est_files INTEGER, status INTEGER,
  run_id TEXT, chunk_seq INTEGER);
CREATE TABLE IF NOT EXISTS session_tapes(
  sid TEXT, seq INTEGER, tape TEXT, file_no INTEGER, PRIMARY KEY(sid,seq));
CREATE TABLE IF NOT EXISTS file_index(
  sid TEXT, path TEXT, size INTEGER, mtime INTEGER, PRIMARY KEY(sid,path));
CREATE INDEX IF NOT EXISTS ix_fi_path ON file_index(path);
"""


def _migrate(c):
    c.executescript(SCHEMA)
    cols = [r[1] for r in c.execute("PRAGMA table_info(sessions)")]
    if "run_id" not in cols:
        c.execute("ALTER TABLE sessions ADD COLUMN run_id TEXT")
    if "chunk_seq" not in cols:
        c.execute("ALTER TABLE sessions ADD COLUMN chunk_seq INTEGER")
    fcols = [r[1] for r in c.execute("PRAGMA table_info(file_index)")]
    if "mtime" not in fcols:
        c.execute("ALTER TABLE file_index ADD COLUMN mtime INTEGER")


def db_init(ctx):
    os.makedirs(ctx.dir, exist_ok=True)
    c = ctx.db()
    _migrate(c)
    c.execute("INSERT OR IGNORE INTO meta(k,v) VALUES('schema','3')")
    c.execute("INSERT OR IGNORE INTO meta(k,v) VALUES('db_host_uuid',?)", (ctx.host_uuid,))
    c.execute("INSERT OR IGNORE INTO meta(k,v) VALUES('db_host_name',?)", (ctx.host_name,))
    c.commit()
    c.close()


def db_open(ctx):
    if not os.path.exists(ctx.dbpath):
        die("index not initialized: run '%s init'" % os.path.basename(SELF))
    c = sqlite3.connect(ctx.dbpath)
    c.execute("PRAGMA journal_mode=WAL")
    _migrate(c)
    c.commit()
    return c


# ---------------------------------------------------------------- tape ops


def sg_path_on_drive(ctx):
    if ctx.rhost:
        cmd = "ls /sys/class/scsi_tape/%s/device/scsi_generic 2>/dev/null | head -1" % os.path.basename(ctx.rdev)
        r = run(ctx.ssh_argv() + [cmd], check=False)
        n = r.stdout.strip()
        return ("/dev/" + n) if n else "/dev/sg0"
    base = os.path.basename(ctx.dev)
    d = "/sys/class/scsi_tape/%s/device/scsi_generic" % base
    if os.path.isdir(d):
        names = sorted(os.listdir(d))
        if names:
            return "/dev/" + names[0]
    return "/dev/sg0"


def drive_env_status(ctx):
    """Read TapeAlert (0x2e) and device statistics (0x14) temperature fields."""
    sg = sg_path_on_drive(ctx)
    out = {}
    wanted = {
        "0x2e": ("Drive temperature", "Drive humidity", "Drive voltage"),
        "0x14": ("Lifetime power on hours when last temperature condition occurred",
                 "Maximum recommended mechanism temperature exceeded"),
    }
    for page, keys in wanted.items():
        cmd = "sudo sg_logs -p %s %s" % (page, sg)
        if ctx.rhost:
            r = run(ctx.ssh_argv() + [cmd], check=False)
        else:
            r = run(cmd.split(), check=False)
        for line in r.stdout.splitlines():
            line = line.strip()
            for k in keys:
                if line.startswith(k + ":"):
                    out[k] = line.split(":", 1)[1].strip()
    return out


def tape_id(ctx):
    """Read MAM from the drive host; returns dict."""
    if ctx.dry:
        return {}
    src = open(SELF).read()
    if ctx.rhost:
        argv = ctx.ssh_argv() + ["sudo python3 - _mam %s" % shlex.quote(ctx.rdev)]
    else:
        argv = ["sudo", "python3", "-", "_mam", ctx.dev]
    r = run(argv, input=src, check=False)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip() or "MAM read failed")
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        raise RuntimeError("bad MAM output: %r" % r.stdout[:200])


def tape_state(mam):
    if not mam:
        return "unknown"
    rem, mx = mam.get("remaining_mb"), mam.get("max_mb")
    if rem and mx and rem == mx:
        return "blank"
    if (mam.get("app_name") or "").upper() == "LTFS":
        return "ltfs"
    if not mam.get("app_name") and not mam.get("barcode") and not mam.get("medium_serial"):
        return "blank"
    return "foreign"


def fmt_mam(mam):
    lines = [
        ("canonical id", mam.get("canonical_id", "")),
        ("barcode", mam.get("barcode", "")),
        ("manufacturer", mam.get("manufacturer", "")),
        ("medium serial", mam.get("medium_serial", "")),
        ("manufacture date", mam.get("manuf_date", "")),
        ("medium type", mam.get("medium_type", "")),
        ("density", mam.get("formatted_density", "")),
        ("capacity", "%s used of %s" % (
            human((mam.get("max_mb", 0) - mam.get("remaining_mb", 0)) * 1024 * 1024),
            human((mam.get("max_mb", 0)) * 1024 * 1024))),
        ("app vendor/name/ver", " ".join(
            x for x in (mam.get("app_vendor"), mam.get("app_name"),
                        mam.get("app_version")) if x)),
        ("volume label", mam.get("volume_label", "")),
        ("LTFS uuid", mam.get("ltfs_uuid", "")),
        ("load count", mam.get("load_count", "")),
        ("lifetime written", human((mam.get("lifetime_written_mb") or 0) * 1024 * 1024)),
        ("tapealert", mam.get("tapealert", "")),
        ("UCI", mam.get("uci", "")),
    ]
    return "\n".join("%-22s %s" % (k, v) for k, v in lines if v not in (None, "", 0))


def pos_file(ctx, n):
    """Seek to 1-based tape file n."""
    ctx.mt("rewind")
    if n > 1:
        ctx.mt("fsf", n - 1)


def read_cur(ctx):
    """Read a short signature from the CURRENT tape position (no seeking)."""
    dev = ctx.rdev if ctx.rhost else ctx.dev
    if ctx.rhost:
        cmd = "sudo dd if=%s bs=4M count=1 2>/dev/null | head -c 120" % shlex.quote(dev)
        r = subprocess.run(ctx.ssh_argv() + [cmd], capture_output=True)
        return r.stdout[:120]
    r = subprocess.run(["sudo", "dd", "if=%s" % dev, "bs=4M", "count=1"],
                       capture_output=True)
    return r.stdout[:120]


def read_sig(ctx, n):
    pos_file(ctx, n)
    return read_cur(ctx)


def sig_kind(raw):
    if raw.startswith(b"TAPEHDR/"):
        return "hdr"
    m = re.match(rb"TAPEIDX\.(\d+)/", raw)
    if m:
        return "idx", int(m.group(1))
    return "data"


def inventory(ctx):
    """Walk the tape; returns list of (file_no, kind, block_no)."""
    ctx.mt("rewind")
    out = []
    n = 1
    while True:
        raw = read_cur(ctx)
        if not raw:
            break
        k = sig_kind(raw)
        if isinstance(k, tuple):
            k, blk = k
            out.append((n, k, blk))
        else:
            out.append((n, k, None))
        if not ctx.mt_try("fsf", 1):
            break
        n += 1
    return out


# ---------------------------------------------------------------- on-tape index blocks


def block_dump(ctx, outdir, cid, barcode, fileno, prev):
    """Create TAPEIDX.<fileno>/ content for sessions touching this tape."""
    bdir = os.path.join(outdir, "TAPEIDX.%d" % fileno)
    os.makedirs(bdir, exist_ok=True)
    c = db_open(ctx)
    sids = [r[0] for r in c.execute(
        "SELECT DISTINCT sid FROM session_tapes WHERE tape=?", (cid,))]
    if not sids:
        c.close()
        return None
    q = "SELECT %s FROM sessions WHERE sid IN (%s)"
    srow = c.execute(q % ("sid||char(9)||ifnull(host_uuid,'')||char(9)||ifnull(host_name,'')"
                          "||char(9)||ifnull(started,'')||char(9)||ifnull(finished,'')"
                          "||char(9)||ifnull(status,0)||char(9)||ifnull(paths,'')"
                          "||char(9)||ifnull(est_size,0)||char(9)||ifnull(est_files,0)"
                          "||char(9)||ifnull(run_id,'')||char(9)||ifnull(chunk_seq,'')",
                          ",".join("?" * len(sids))), sids).fetchall()
    with open(os.path.join(bdir, "sessions.tsv"), "w") as f:
        for row in srow:
            f.write(row[0] + "\n")
    with open(os.path.join(bdir, "session_tapes.tsv"), "w") as f:
        for sid, seq, tape, fno in c.execute(
                "SELECT sid,seq,tape,file_no FROM session_tapes WHERE sid IN (%s) ORDER BY sid,seq"
                % ",".join("?" * len(sids)), sids):
            f.write("%s\t%d\t%s\t%d\n" % (esc(sid), seq, esc(tape), fno))
    with open(os.path.join(bdir, "file_index.tsv"), "w") as f:
        for sid, path, size, mt in c.execute(
                "SELECT sid,path,size,mtime FROM file_index WHERE sid IN (%s)"
                % ",".join("?" * len(sids)), sids):
            f.write("%s\t%s\t%d\t%s\n" % (esc(sid), esc(path), size,
                                             "" if mt is None else mt))
    cids = [r[0] for r in c.execute(
        "SELECT DISTINCT tape FROM session_tapes WHERE sid IN (%s)"
        % ",".join("?" * len(sids)), sids)]
    run_ids = [r[0] for r in c.execute(
        "SELECT DISTINCT run_id FROM sessions WHERE sid IN (%s) AND run_id IS NOT NULL"
        % ",".join("?" * len(sids)), sids)]
    if run_ids:
        with open(os.path.join(bdir, "runs.tsv"), "w") as f:
            for row in c.execute("SELECT run_id,started,finished,source,chunk_bytes,n_chunks,status"
                                 " FROM runs WHERE run_id IN (%s)" % ",".join("?" * len(run_ids)),
                                 run_ids):
                f.write("\t".join(esc(x if x is not None else "") for x in row) + "\n")
    with open(os.path.join(bdir, "tapes.tsv"), "w") as f:
        for (tid,) in c.execute("SELECT cid FROM tapes WHERE cid IN (%s)"
                                % ",".join("?" * len(cids)), cids):
            row = c.execute("SELECT cid,barcode,created,created_by FROM tapes WHERE cid=?",
                            (tid,)).fetchone()
            f.write("\t".join(esc(x or "") for x in row) + "\n")
    c.close()
    with open(os.path.join(bdir, "meta.txt"), "w") as f:
        f.write("tapebackup-index-block 1\n")
        f.write("tape: %s\n" % cid)
        f.write("barcode: %s\n" % (barcode or ""))
        f.write("block_file: %d\n" % fileno)
        f.write("prev_block: %s\n" % ("" if prev is None else prev))
        f.write("writer: %s (%s)\n" % (ctx.host_name, ctx.host_uuid))
        f.write("date: %s\n" % time.strftime("%Y-%m-%d %H:%M:%S"))
    return bdir


def block_merge(ctx, bdir, tape_cid_hint=None):
    """Merge one TAPEIDX.<n> directory into the DB (latest wins)."""
    c = db_open(ctx)
    try:
        p = os.path.join(bdir, "sessions.tsv")
        if os.path.exists(p):
            for line in open(p):
                line = line.rstrip("\n")
                if not line:
                    continue
                parts = line.split("\t")
                if len(parts) >= 11:
                    sid, hu, hn, st, fin, status, paths, esz, efc, rid, cseq = parts[:11]
                else:
                    sid, hu, hn, st, fin, status, paths, esz, efc = parts[:9]
                    rid, cseq = "", ""
                c.execute("INSERT OR REPLACE INTO sessions"
                          "(sid,host_uuid,host_name,started,finished,paths,est_size,"
                          "est_files,status,run_id,chunk_seq) VALUES(?,?,?,?,?,?,?,?,?,?,?)",
                          (sid, hu, hn, st, fin, unesc(paths),
                           int(esz or 0), int(efc or 0), int(status or 0),
                           rid or None, int(cseq) if cseq else None))
        p = os.path.join(bdir, "session_tapes.tsv")
        if os.path.exists(p):
            for line in open(p):
                line = line.rstrip("\n")
                if not line:
                    continue
                sid, seq, tape, fno = line.split("\t")
                c.execute("INSERT OR REPLACE INTO session_tapes VALUES(?,?,?,?)",
                          (sid, int(seq), unesc(tape), int(fno)))
        p = os.path.join(bdir, "file_index.tsv")
        if os.path.exists(p):
            for line in open(p):
                line = line.rstrip("\n")
                if not line:
                    continue
                parts = line.split("\t")
                sid, path, size = parts[0], parts[1], parts[2]
                mt = int(parts[3]) if len(parts) > 3 and parts[3] else None
                c.execute("INSERT OR REPLACE INTO file_index(sid,path,size,mtime)"
                          " VALUES(?,?,?,?)", (sid, unesc(path), int(size), mt))
        p = os.path.join(bdir, "runs.tsv")
        if os.path.exists(p):
            for line in open(p):
                line = line.rstrip("\n")
                if not line:
                    continue
                parts = [unesc(x) for x in (line.split("\t") + [""] * 7)[:7]]
                c.execute("INSERT OR REPLACE INTO runs VALUES(?,?,?,?,?,?,?)",
                          (parts[0], parts[1], parts[2] or None, parts[3],
                           int(parts[4] or 0), int(parts[5] or 0), int(parts[6] or 0)))
        p = os.path.join(bdir, "tapes.tsv")
        if os.path.exists(p):
            for line in open(p):
                line = line.rstrip("\n")
                if not line:
                    continue
                cid, bc, created, by = (line.split("\t") + [""] * 4)[:4]
                c.execute("INSERT OR IGNORE INTO tapes(cid,barcode,created,created_by)"
                          " VALUES(?,?,?,?)", (unesc(cid), unesc(bc), unesc(created), unesc(by)))
        c.commit()
    finally:
        c.close()


def scan_tape(ctx):
    """Inventory + merge all index blocks. Returns (cid_from_blocks, inv)."""
    inv = inventory(ctx)
    cids = []
    tmp = tempfile.mkdtemp(prefix="tbscan.")
    try:
        for n, kind, blk in inv:
            if kind != "idx":
                continue
            pos_file(ctx, n)
            name = "TAPEIDX.%d" % blk
            ctx.tar(["-x", "-C", tmp, name])
            bdir = os.path.join(tmp, name)
            block_merge(ctx, bdir)
            mtxt = os.path.join(bdir, "meta.txt")
            if os.path.exists(mtxt):
                for line in open(mtxt):
                    if line.startswith("tape: "):
                        cids.append(line[6:].strip())
    finally:
        subprocess.run(["rm", "-rf", tmp])
    return (cids[-1] if cids else None), inv


