def _check(ctx, args):
    db_open(ctx).close()
    c = db_open(ctx)
    if args:
        rows = c.execute("SELECT s.sid,st.tape,st.file_no FROM session_tapes st"
                         " JOIN sessions s ON s.sid=st.sid WHERE st.tape=? ORDER BY s.started",
                         (args[0],)).fetchall()
        if not rows:
            die("no sessions recorded for tape %s" % args[0])
    else:
        rows = c.execute("SELECT s.sid,st.tape,st.file_no FROM session_tapes st"
                         " JOIN sessions s ON s.sid=st.sid ORDER BY s.started").fetchall()
    c.close()
    cur = None
    bad = 0
    for sid, tape, fno in rows:
        if tape != cur:
            if cur is not None and not ctx.dry:
                ctx.mt_try("offline")
            print("tape %s — insert and press ENTER" % tape)
            if not ctx.dry:
                sys.stdin.readline()
                ctx.ensure_ready()
            cur = tape
        pos_file(ctx, fno)
        r = ctx.tar(["-t"], check=False)
        if r.returncode in (0, 1):
            print("  %s file %d: OK" % (sid[:8], fno))
        else:
            print("  %s file %d: READ ERROR" % (sid[:8], fno))
            bad += 1
    sys.exit(1 if bad else 0)


def cmd_erase(ctx, args):
    yes = any(a in ("-y", "--yes") for a in args)
    force = "--force" in args
    long = "--long" in args
    db_open(ctx).close()
    ctx.lock()
    tick("lock acquired")
    try:
        ctx.ensure_ready()
        try:
            mam = tape_id(ctx)
        except RuntimeError as e:
            die("cannot identify tape: %s" % e)
        cid = mam.get("canonical_id") or ""
        if not cid:
            die("tape has no MAM identity")
        bc = mam.get("barcode", "")
        # merge the tape's own index blocks first, so sessions written by other
        # hosts are discovered and reported too
        try:
            if read_sig(ctx, 1).startswith(b"TAPEHDR/"):
                print("scanning existing index blocks ...")
                scan_tape(ctx)
        except SystemExit:
            pass
        c = db_open(ctx)
        sids = [r[0] for r in c.execute(
            "SELECT DISTINCT sid FROM session_tapes WHERE tape=?", (cid,))]
        info, spanning = [], []
        for sid in sids:
            row = c.execute("SELECT started,paths,est_size FROM sessions WHERE sid=?",
                            (sid,)).fetchone()
            tapes = [r[0] for r in c.execute(
                "SELECT DISTINCT tape FROM session_tapes WHERE sid=?", (sid,))]
            if len(tapes) > 1:
                spanning.append((sid, tapes))
            info.append((sid, row, tapes))
        print(fmt_mam(mam))
        print("%-22s %s (%s)" % ("tape to erase", cid, bc or "-"))
        if info:
            print("sessions that will be removed from the index:")
            for sid, row, tapes in info:
                started = row[0] if row else "?"
                size = human((row[2] or 0)) if row else "?"
                print("  %s  %s  %s  paths=%s" % (sid[:8], started, size,
                                                  row[1] if row else "?"))
        else:
            print("(no sessions recorded on this tape)")
        if spanning and not force:
            die("some sessions span other tapes and would become unrestorable — "
                "rerun with --force if you accept losing them")
        if not yes:
            print("This ERASES the tape and deletes %d session(s) from the index."
                  % len(info))
            sys.stdout.write("Type YES to continue: ")
            sys.stdout.flush()
            if sys.stdin.readline().strip() != "YES":
                die("aborted")
        print("erasing tape (%s) ..." % ("long/full" if long else "quick"))
        ctx.mt_try("rewind")   # short erase starts at the current position
        t0 = time.time()
        ctx.sg_erase(long=long)
        time.sleep(2)
        mam2 = tape_id(ctx)
        rem = mam2.get("remaining_mb")
        mx = mam2.get("max_mb")
        print("erase done in %.0fs; capacity %s of %s"
              % (time.time() - t0, human((rem or 0) * 1024 * 1024),
                 human((mx or 0) * 1024 * 1024)))
        for sid, _, _ in info:
            c.execute("DELETE FROM file_index WHERE sid=?", (sid,))
            c.execute("DELETE FROM session_tapes WHERE sid=?", (sid,))
            c.execute("DELETE FROM sessions WHERE sid=?", (sid,))
        c.execute("DELETE FROM tapes WHERE cid=?", (cid,))
        c.execute("DELETE FROM runs WHERE run_id NOT IN "
                  "(SELECT DISTINCT run_id FROM sessions WHERE run_id IS NOT NULL)")
        c.commit()
        c.close()
        print("removed %d session(s)/tape row %s (orphan runs cleaned)" % (len(info), cid))
        print("NOTE: other hosts' indexes are not updated; run on each of them:")
        print("      tapebackup forget --tape %s" % cid)
        ctx.mt_try("rewind")
    finally:
        ctx.unlock()


def cmd_forget(ctx, args):
    force = "--force" in args
    args = [a for a in args if a != "--force"]
    if len(args) < 2 or args[0] != "--tape":
        die("usage: forget --tape CANONICAL_ID [--force]")
    cid = args[1]
    c = db_open(ctx)
    sids = [r[0] for r in c.execute(
        "SELECT DISTINCT sid FROM session_tapes WHERE tape=?", (cid,))]
    if not sids:
        print("no sessions recorded for tape %s" % cid)
        c.close()
        return
    spanned = []
    for sid in sids:
        tapes = [r[0] for r in c.execute(
            "SELECT DISTINCT tape FROM session_tapes WHERE sid=?", (sid,))]
        if len(tapes) > 1:
            spanned.append((sid, tapes))
    if spanned and not force:
        for sid, tapes in spanned:
            print("session %s also uses: %s" % (sid[:8], ", ".join(tapes)), file=sys.stderr)
        die("some sessions span other tapes; rerun with --force to forget them anyway")
    for sid in sids:
        c.execute("DELETE FROM file_index WHERE sid=?", (sid,))
        c.execute("DELETE FROM session_tapes WHERE sid=?", (sid,))
        c.execute("DELETE FROM sessions WHERE sid=?", (sid,))
    c.execute("DELETE FROM tapes WHERE cid=?", (cid,))
    c.execute("DELETE FROM runs WHERE run_id NOT IN "
              "(SELECT DISTINCT run_id FROM sessions WHERE run_id IS NOT NULL)")
    c.commit()
    c.close()
    print("forgot %d session(s) and tape %s from this host's index" % (len(sids), cid))


