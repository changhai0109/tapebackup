def gen_switch_script(ctx, path, state_file, mode):
    """Generate the tar -F volume-switch helper."""
    selfcmd = "python3 %s _peek" % shlex.quote(SELF)
    if ctx.rhost:
        off = " ".join(shlex.quote(x) for x in
                       ctx.ssh_argv() + ["sudo mt -f %s offline" % shlex.quote(ctx.rdev)])
    else:
        off = "sudo mt -f %s offline" % shlex.quote(ctx.dev)
    lines = ["#!/bin/bash", "set -u"]
    if mode == "write":
        lines += [
            "%s >/dev/null 2>&1 || true" % off,
            "printf '\\n>>> Tape full. Insert the NEXT (blank) tape, then press ENTER: ' >/dev/tty",
            "read -r _ </dev/tty || exit 1",
            "line=$(%s 2>/dev/null | tail -1)" % selfcmd,
            "cid=$(printf '%%s' \"$line\" | cut -f1); bc=$(printf '%%s' \"$line\" | cut -f2)",
            "[ -n \"$cid\" ] || cid=UNKNOWN",
            "printf '%%s\\t%%s\\t1\\n' \"$cid\" \"$bc\" >> %s" % shlex.quote(state_file),
            "printf '>>> recorded tape: %%s\\n' \"$cid\" >/dev/tty",
            "exit 0",
        ]
    else:
        lbl = state_file + ".lbl"
        lines += [
            "%s >/dev/null 2>&1 || true" % off,
            "line=$(head -1 %s 2>/dev/null)" % shlex.quote(lbl),
            "[ -n \"$line\" ] || line='<next tape>'",
            "printf '\\n>>> Insert tape [%%s], then press ENTER: ' \"$line\" >/dev/tty",
            "read -r _ </dev/tty || exit 1",
            "sed -i '1d' %s 2>/dev/null || true" % shlex.quote(lbl),
            "exit 0",
        ]
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.chmod(path, 0o755)


