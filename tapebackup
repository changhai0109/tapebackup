def usage():
    print(__doc__ or "")
    print("""
Commands:
  init                        create index DB
  set-host NAME               set human-readable host name (default: hostname)
  inspect                     show tape MAM identity + content state
  write [--force] [--chunk-size 50G] [--rate MBps] [--cooldown SEC] SRC...
                              chunked backup (per-chunk index + lock)
  find [--all] PATTERN        search index (latest per path; --all = every version)
  versions PATH               list all backup versions of one path
  extract -C DIR [--sid N | --at DATE | --run R | PATH...]
                              restore one chunk, a whole run, or exact paths
  check [TAPE]                read-verify recorded archives
  resume RUN_ID [--force] [--rate MBps] [--cooldown SEC]
                              continue an interrupted chunked run
  runs                        list runs (chunked backup sets)
  erase [-y] [--force] [--long]   ERASE tape and delete its sessions from index
  forget --tape CID [--force]     remove a tape's sessions from THIS index only
  remove [--yes] [--prune-dirs] PATH...
                              delete local files already backed up unchanged
  scan                        read tape's index blocks into local DB
  monitor [--interval N] [--log FILE] [--once]
                              watch drive temperature/humidity TapeAlert flags
  ls [-R] [HOST:]PATH         browse index (deduped: latest version)
  tapes                       list tapes
  sessions                    list sessions
Global flag:
  -n, --dry-run               print plan, touch nothing
""")


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "_mam":
        _mam_cmd(argv)
        return
    if argv and argv[0] == "_ready":
        _ready_cmd(argv)
        return
    if argv and argv[0] == "_load":
        _load_cmd(argv)
        return
    if argv and argv[0] == "_erase":
        _erase_cmd(argv)
        return
    dry = False
    if argv and argv[0] in ("-n", "--dry-run"):
        dry = True
        argv = argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        return
    cmd, args = argv[0], argv[1:]
    ctx = Ctx(dry=dry)
    try:
        if cmd == "init":
            cmd_init(ctx, args)
        elif cmd == "set-host":
            cmd_set_host(ctx, args)
        elif cmd == "inspect":
            cmd_inspect(ctx, args)
        elif cmd == "write":
            cmd_write(ctx, args)
        elif cmd == "find":
            cmd_find(ctx, args)
        elif cmd == "extract":
            cmd_extract(ctx, args)
        elif cmd == "check":
            cmd_check(ctx, args)
        elif cmd == "resume":
            cmd_resume(ctx, args)
        elif cmd == "runs":
            cmd_runs(ctx, args)
        elif cmd == "erase":
            cmd_erase(ctx, args)
        elif cmd == "forget":
            cmd_forget(ctx, args)
        elif cmd == "scan":
            cmd_scan(ctx, args)
        elif cmd == "ls":
            cmd_ls(ctx, args)
        elif cmd == "versions":
            cmd_versions(ctx, args)
        elif cmd == "monitor":
            cmd_monitor(ctx, args)
        elif cmd == "temp":
            cmd_monitor(ctx, args + ["--once"])
        elif cmd == "remove":
            cmd_remove(ctx, args)
        elif cmd == "tapes":
            cmd_tapes(ctx, args)
        elif cmd == "sessions":
            cmd_sessions(ctx, args)
        elif cmd == "_peek":
            cmd_peek(ctx, args)
        else:
            die("unknown command: %s (see help)" % cmd)
    finally:
        try:
            ctx.unlock()
        except Exception:
            pass


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        sys.exit(0)
