def _scan(ctx, args):
    ctx.ensure_ready()
    try:
        mam = tape_id(ctx)
    except RuntimeError as e:
        die(str(e))
    cid = (mam or {}).get("canonical_id", "")
    try:
        if read_sig(ctx, 1).startswith(b"TAPEHDR/"):
            print("%-22s %s" % ("format", "tapebackup v2"))
    except SystemExit:
        pass
    print(fmt_mam(mam) if mam else "(no MAM data)")
    prev = None
    c = db_open(ctx)
    if cid:
        c.execute("INSERT OR IGNORE INTO tapes(cid,barcode,created,created_by) VALUES(?,?,?,?)",
                  (cid, (mam or {}).get("barcode", ""),
                   time.strftime("%Y-%m-%d %H:%M:%S"),
                   "%s (%s)" % (ctx.host_name, ctx.host_uuid)))
        c.commit()
    c.close()
    print("scanning tape ...")
    inv = inventory(ctx)
    print("files found: %d" % len(inv))
    tmp = tempfile.mkdtemp(prefix="tbscan.")
    merged = 0
    try:
        for n, kind, blk in inv:
            if kind != "idx":
                continue
            pos_file(ctx, n)
            name = "TAPEIDX.%d" % blk
            ctx.tar(["-x", "-C", tmp, name])
            block_merge(ctx, os.path.join(tmp, name))
            merged += 1
    finally:
        subprocess.run(["rm", "-rf", tmp])
    print("index blocks merged: %d" % merged)
    if not merged:
        print("no tapebackup index blocks on this tape (foreign/mid-span tape)")


def cmd_monitor(ctx, args):
    interval = 15
    logf = None
    once = False
    if "--interval" in args:
        i = args.index("--interval")
        interval = int(args[i + 1])
    if "--log" in args:
        i = args.index("--log")
        logf = args[i + 1]
    if "--once" in args:
        once = True
    fh = open(logf, "a") if logf else None

    def emit(line):
        print(line, flush=True)
        if fh:
            fh.write(line + "\n")
            fh.flush()

    emit("# time                      temp humidity voltage  last_temp_event_h  max_mech_temp_exceeded")
    try:
        while True:
            st = drive_env_status(ctx)
            t = st.get("Drive temperature", "?")
            h = st.get("Drive humidity", "?")
            v = st.get("Drive voltage", "?")
            lt = st.get("Lifetime power on hours when last temperature condition occurred", "?")
            mx = st.get("Maximum recommended mechanism temperature exceeded", "?")
            line = "%-26s %-4s %-8s %-8s %-18s %s" % (
                time.strftime("%Y-%m-%d %H:%M:%S"), t, h, v, lt, mx)
            if t == "1":
                line += "   << OVERHEAT ALERT (TapeAlert 29) >>"
            elif h == "1":
                line += "   << HUMIDITY ALERT >>"
            emit(line)
            if once:
                break
            time.sleep(interval)
    except KeyboardInterrupt:
        pass
    finally:
        if fh:
            fh.close()


